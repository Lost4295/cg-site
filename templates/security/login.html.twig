{% extends 'base.html.twig' %}

{% block title %}Se connecter{% endblock %}

{% block body %}
    <div class="row h-100">
        <div class="col d-flex justify-content-center align-items-center my-5">
            <div class="card col-5 m-5">
                <div class="card-body">
                    {% if not is_granted('IS_AUTHENTICATED_FULLY') %}
                        <form action="{{ path('oauth_discord') }}" method="post" class="w-100 h-100">
                            <input type="hidden" name="token" value="{{ csrf_token('discord-auth') }}"/>
                            <button class="w-100 btn btn-lg btn-primary" type="submit">Connexion avec <span
                                    class="fa fa-discord"></span> Discord
                            </button>
                        </form>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>


{% endblock %}
